# Copy values into your environment (these are read as environment variables; no
# secrets are required). All settings are optional.

# Where the database, audio, exports and (by default) models are stored.
# Default: %LOCALAPPDATA%\HamzaVoiceStudio (Windows), ~/.local/share/HamzaVoiceStudio (Linux),
#          ~/Library/Application Support/HamzaVoiceStudio (macOS)
# HVS_DATA_DIR=

# Store model files elsewhere (e.g. a larger drive).
# HVS_MODELS_DIR=

# Preferred port (a free one is chosen if busy, unless --strict-port is used).
# HVS_PORT=8765

# Fixed session token (normally generated per launch). Only for development/testing.
# HVS_TOKEN=

# Extra browser origins allowed to call the API (Vite dev server).
# HVS_DEV_ORIGINS=http://127.0.0.1:5173

# CPU threads used for inference (default: min(4, CPU count)).
# HVS_INFERENCE_THREADS=4

# Job system tuning
# HVS_LEASE_SECONDS=30
# HVS_MAX_AUTO_RETRIES=1
# HVS_MAX_QUEUED_JOBS=500
