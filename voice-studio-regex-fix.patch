-    word = re.findall(r"[\w.]+$", text[start:dot])
-    w = word[0].lower() if word else ""
+    # Scan the trailing token directly: an unanchored regex can retry long
+    # partial matches at every position when user input ends in punctuation.
+    end = dot
+    if end > start and text[end - 1] == "\n":  # preserve regex $ semantics
+        end -= 1
+    token_start = end
+    while token_start > start:
+        ch = text[token_start - 1]
+        if not (ch.isalnum() or ch in "_."):
+            break
+        token_start -= 1
+    w = text[token_start:end].lower()
     if w in ABBREV:
